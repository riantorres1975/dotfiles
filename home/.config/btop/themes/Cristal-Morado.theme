# Local theme matching Kitty's dark palette and KWin's purple borders.
# Empty main_bg lets Kitty provide its background and 80% opacity.
theme[main_bg]=""
theme[main_fg]="#cdd6f4"
theme[title]="#dcc5ff"
theme[hi_fg]="#c061ff"
theme[selected_bg]="#c061ff"
theme[selected_fg]="#1e1e2e"
theme[inactive_fg]="#7f849c"
theme[graph_text]="#cdd6f4"
theme[meter_bg]="#45475a"
theme[proc_misc]="#89dceb"

# Unified purple outlines, with quieter internal dividers.
theme[cpu_box]="#c061ff"
theme[mem_box]="#c061ff"
theme[net_box]="#c061ff"
theme[proc_box]="#c061ff"
theme[div_line]="#584070"

# Keep warmer high-temperature colors recognizable.
theme[temp_start]="#89dceb"
theme[temp_mid]="#cba6f7"
theme[temp_end]="#f38ba8"

theme[cpu_start]="#89dceb"
theme[cpu_mid]="#cba6f7"
theme[cpu_end]="#c061ff"

theme[free_start]="#94e2d5"
theme[free_mid]="#89dceb"
theme[free_end]="#74c7ec"
theme[cached_start]="#89b4fa"
theme[cached_mid]="#b4befe"
theme[cached_end]="#cba6f7"
theme[available_start]="#94e2d5"
theme[available_mid]="#89dceb"
theme[available_end]="#b4befe"
theme[used_start]="#b4befe"
theme[used_mid]="#cba6f7"
theme[used_end]="#c061ff"

theme[download_start]="#94e2d5"
theme[download_mid]="#89dceb"
theme[download_end]="#74c7ec"
theme[upload_start]="#b4befe"
theme[upload_mid]="#cba6f7"
theme[upload_end]="#c061ff"

theme[process_start]="#89dceb"
theme[process_mid]="#cba6f7"
theme[process_end]="#c061ff"
